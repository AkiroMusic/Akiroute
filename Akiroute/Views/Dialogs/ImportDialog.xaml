<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Akiroute.Views.Dialogs.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="导入节点"
    PrimaryButtonText="导入"
    CloseButtonText="取消"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="12" MinWidth="420">
        <!-- Input mode switch: pasted links/YAML or a subscription URL. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <RadioButton
                x:Name="LinkMode"
                Content="粘贴链接"
                GroupName="ImportMode"
                Checked="Mode_Checked" />
            <RadioButton
                x:Name="UrlMode"
                Content="订阅地址"
                GroupName="ImportMode"
                Checked="Mode_Checked" />
        </StackPanel>

        <TextBox
            x:Name="PasteBox"
            Height="140"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            PlaceholderText="粘贴 vless://, vmess://, ss://, trojan://, hysteria2://, tuic:// 链接或 Clash 配置"
            TextChanged="Input_TextChanged" />

        <TextBox
            x:Name="UrlBox"
            PlaceholderText="https:// 订阅地址"
            Visibility="Collapsed"
            TextChanged="Input_TextChanged" />
    </StackPanel>
</ContentDialog>
