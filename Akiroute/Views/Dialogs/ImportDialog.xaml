<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Akiroute.Views.Dialogs.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="ImportDlg"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="12" MinWidth="420">
        <!-- Input mode switch: pasted links/YAML or a subscription URL. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <RadioButton
                x:Name="LinkMode"
                x:Uid="ImportLinkMode"
                GroupName="ImportMode"
                Checked="Mode_Checked" />
            <RadioButton
                x:Name="UrlMode"
                x:Uid="ImportUrlMode"
                GroupName="ImportMode"
                Checked="Mode_Checked" />
        </StackPanel>

        <TextBox
            x:Name="PasteBox"
            Height="140"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            x:Uid="ImportPasteBox"
            TextChanged="Input_TextChanged" />

        <TextBox
            x:Name="UrlBox"
            x:Uid="ImportUrlBox"
            Visibility="Collapsed"
            TextChanged="Input_TextChanged" />
    </StackPanel>
</ContentDialog>
