<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Akiroute.Views.Dialogs.EditNodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="EditNodeDlg"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MinWidth="420">
            <TextBox
                x:Name="NameBox"
                x:Uid="EditNodeName" />

            <ComboBox
                x:Name="TypeBox"
                x:Uid="EditNodeType" />

            <TextBox
                x:Name="AddressBox"
                x:Uid="EditNodeAddr" />

            <TextBox
                x:Name="PortBox"
                x:Uid="EditNodePort"
                PlaceholderText="1 - 65535" />

            <!--
                Protocol-specific fields (uuid, sni, password, ...) held as raw JSON.
                Round-tripped with System.Text.Json.Nodes only — no reflection.
            -->
            <Expander
                x:Name="ExtraExpander"
                x:Uid="EditNodeExtra">
                <TextBox
                    x:Name="ExtraParamsBox"
                    Height="140"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontFamily="{StaticResource EtFontMono}"
                    FontSize="12"
                    PlaceholderText="{}{ }" />
            </Expander>

            <TextBlock
                x:Name="ValidationText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
