<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Akiroute.Views.Controls.TrafficChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource EtFontSans}">

    <UserControl.Resources>
        <!--
            Translucent accent gradient under the waveform: bright near the line,
            fading to transparent at the bottom. Built from the Ethereal accent so
            it follows the active theme; the brush-level Opacity keeps the area
            subtle (GradientStop has no Opacity member in WinUI 3).
        -->
        <LinearGradientBrush
            x:Key="WaveAreaBrush"
            StartPoint="0,0"
            EndPoint="0,1"
            Opacity="0.35">
            <GradientStop Offset="0" Color="{ThemeResource EtAccentColor}" />
            <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <!--
        Lightweight real-time throughput waveform. No chart library: the series
        is drawn as a Polyline inside a Canvas, repainted from the DataPoints
        collection by the code-behind. Gridlines sit behind the trace.
    -->
    <Grid Height="120">
        <Canvas
            x:Name="ChartCanvas"
            IsHitTestVisible="False"
            SizeChanged="ChartCanvas_SizeChanged">
            <Line
                x:Name="GridLine25"
                IsHitTestVisible="False"
                Stroke="{ThemeResource EtBorderBrush}"
                StrokeThickness="1" />
            <Line
                x:Name="GridLine50"
                IsHitTestVisible="False"
                Stroke="{ThemeResource EtBorderBrush}"
                StrokeThickness="1" />
            <Line
                x:Name="GridLine75"
                IsHitTestVisible="False"
                Stroke="{ThemeResource EtBorderBrush}"
                StrokeThickness="1" />
            <Polyline
                x:Name="WaveFill"
                IsHitTestVisible="False"
                StrokeThickness="0"
                Fill="{StaticResource WaveAreaBrush}" />
            <Polyline
                x:Name="WaveLine"
                IsHitTestVisible="False"
                Stroke="{ThemeResource EtAccentBrush}"
                StrokeThickness="2"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" />
        </Canvas>

        <!-- Optional chart label (e.g. "实时流量"), top-left overlay. -->
        <TextBlock
            x:Name="TitleText"
            Margin="10,6,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="12"
            Foreground="{ThemeResource EtTextSecondaryBrush}"
            Visibility="Collapsed" />

        <!-- Shown only when the series is empty. -->
        <TextBlock
            x:Name="HintText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Opacity="0.6"
            Foreground="{ThemeResource EtTextSecondaryBrush}"
            x:Uid="TrafficEmptyHint"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
