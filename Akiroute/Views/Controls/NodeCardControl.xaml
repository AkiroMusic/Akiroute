<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Akiroute.Views.Controls.NodeCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource EtFontSans}"
    IsTabStop="True"
    GotFocus="OnGotFocus"
    LostFocus="OnLostFocus">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <!-- Pointer feedback, mirroring ProcessItemControl's CommonStates. -->
            <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource EtTextPrimary6Brush}" />
                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource EtBorderBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource EtAccent12Brush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--
                Selection highlight: the accent-tinted background + accent border
                are driven from code (Refresh) via this dedicated state group so a
                hover never erases the selected indication.
            -->
            <VisualStateGroup x:Name="SelectionStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource EtAccent13Brush}" />
                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource EtAccentBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--
                Latency badge color coding: green &lt;100 ms, caution &lt;300 ms,
                critical ≥300 ms, gray "未测" for untested (-1).
            -->
            <VisualStateGroup x:Name="LatencyStates">
                <VisualState x:Name="LatencyUntested">
                    <VisualState.Setters>
                        <Setter Target="LatencyBadge.Background" Value="{ThemeResource EtSurface2Brush}" />
                        <Setter Target="LatencyText.Foreground" Value="{ThemeResource EtTextTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LatencyGreen">
                    <VisualState.Setters>
                        <Setter Target="LatencyBadge.Background" Value="{ThemeResource EtSuccess8Brush}" />
                        <Setter Target="LatencyText.Foreground" Value="{ThemeResource EtSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LatencyCaution">
                    <VisualState.Setters>
                        <Setter Target="LatencyBadge.Background" Value="{ThemeResource EtWarning8Brush}" />
                        <Setter Target="LatencyText.Foreground" Value="{ThemeResource EtWarningBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LatencyCritical">
                    <VisualState.Setters>
                        <Setter Target="LatencyBadge.Background" Value="{ThemeResource EtError8Brush}" />
                        <Setter Target="LatencyText.Foreground" Value="{ThemeResource EtErrorBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--
                Keyboard focus ring (driven from code-behind GotFocus/LostFocus):
                a 2px double-ring drawn just outside CardRoot, matching the
                Fluent focus convention used by the styled buttons.
            -->
            <VisualStateGroup x:Name="FocusStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="Focused">
                    <VisualState.Setters>
                        <Setter Target="FocusOuter.BorderBrush" Value="{ThemeResource FocusVisualPrimaryBrush}" />
                        <Setter Target="FocusInner.BorderBrush" Value="{ThemeResource FocusVisualSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
            Single-row node card. The root is a plain Grid so the control stretches
            to the full ListView row width; the card itself is the inner rounded
            Border. Tapping the card raises NodeClicked for the parent to handle.
        -->
        <Border
            x:Name="CardRoot"
            Height="64"
            Margin="0,4"
            Padding="12,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="{ThemeResource EtSurface1Brush}"
            BorderBrush="{ThemeResource EtBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource EtRadiusSm}"
            Tapped="CardRoot_Tapped"
            PointerEntered="CardRoot_PointerEntered"
            PointerExited="CardRoot_PointerExited"
            PointerPressed="CardRoot_PointerPressed"
            PointerReleased="CardRoot_PointerReleased"
            PointerCaptureLost="CardRoot_PointerCaptureLost">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Node name + host:port detail line. -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="NameText"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource EtTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="DetailText"
                        FontSize="12"
                        Foreground="{ThemeResource EtTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Latency pill; color and text are driven by the LatencyStates group. -->
                <Border
                    x:Name="LatencyBadge"
                    Grid.Column="1"
                    MinWidth="52"
                    Height="22"
                    VerticalAlignment="Center"
                    CornerRadius="11"
                    Padding="8,0"
                    Background="{ThemeResource EtSurface2Brush}">
                    <TextBlock
                        x:Name="LatencyText"
                        x:Uid="NodeCardUntested"
                        FontSize="11"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource EtTextTertiaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Keyboard focus rings (transparent until FocusStates/Focused). -->
        <Border
            x:Name="FocusOuter"
            BorderThickness="2"
            BorderBrush="Transparent"
            CornerRadius="{StaticResource EtRadiusSm}"
            Margin="-3,1"
            IsHitTestVisible="False" />
        <Border
            x:Name="FocusInner"
            BorderThickness="1"
            BorderBrush="Transparent"
            CornerRadius="{StaticResource EtRadiusSm}"
            Margin="-1,3"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
