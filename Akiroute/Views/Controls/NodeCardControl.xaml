<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Akiroute.Views.Controls.NodeCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <!-- Pointer feedback, mirroring ProcessItemControl's CommonStates. -->
            <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--
                Selection highlight: the accent-tinted background + accent border
                are driven from code (Refresh) via this dedicated state group so a
                hover never erases the selected indication.
            -->
            <VisualStateGroup x:Name="SelectionStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--
                Latency badge color coding: green &lt;100 ms, caution &lt;300 ms,
                critical ≥300 ms, gray "未测" for untested (-1).
            -->
            <VisualStateGroup x:Name="LatencyStates">
                <VisualState x:Name="LatencyUntested">
                    <VisualState.Setters>
                        <Setter Target="LatencyBadge.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                        <Setter Target="LatencyText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LatencyGreen">
                    <VisualState.Setters>
                        <Setter Target="LatencyBadge.Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="LatencyText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LatencyCaution">
                    <VisualState.Setters>
                        <Setter Target="LatencyBadge.Background" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="LatencyText.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LatencyCritical">
                    <VisualState.Setters>
                        <Setter Target="LatencyBadge.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="LatencyText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
            Single-row node card. The root is a plain Grid so the control stretches
            to the full ListView row width; the card itself is the inner rounded
            Border. Tapping the card raises NodeClicked for the parent to handle.
        -->
        <Border
            x:Name="CardRoot"
            Height="64"
            Margin="0,4"
            Padding="12,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Tapped="CardRoot_Tapped"
            PointerEntered="CardRoot_PointerEntered"
            PointerExited="CardRoot_PointerExited"
            PointerPressed="CardRoot_PointerPressed"
            PointerReleased="CardRoot_PointerReleased"
            PointerCaptureLost="CardRoot_PointerCaptureLost">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Node name + host:port detail line. -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="NameText"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="DetailText"
                        FontSize="12"
                        Opacity="0.6"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Latency pill; color and text are driven by the LatencyStates group. -->
                <Border
                    x:Name="LatencyBadge"
                    Grid.Column="1"
                    MinWidth="52"
                    Height="22"
                    VerticalAlignment="Center"
                    CornerRadius="11"
                    Padding="8,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock
                        x:Name="LatencyText"
                        Text="未测"
                        FontSize="11"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
