<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Akiroute.Views.Controls.ProcessItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource EtFontSans}">

    <UserControl.Resources>
        <!--
            Segment-style radio button: a rounded pill that fills with the accent
            brush when checked. PointerOver / Pressed / Checked states are managed
            automatically by the RadioButton control (CommonStates / CheckStates).
        -->
        <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{ThemeResource EtTextSecondaryBrush}" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.12" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentRoot.Background" Value="{ThemeResource EtTextPrimary6Brush}" />
                                            <Setter Target="FocusOuter.BorderBrush" Value="Transparent" />
                                            <Setter Target="FocusInner.BorderBrush" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentRoot.Background" Value="{ThemeResource EtTextPrimary6Brush}" />
                                            <Setter Target="FocusOuter.BorderBrush" Value="Transparent" />
                                            <Setter Target="FocusInner.BorderBrush" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.12" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentRoot.Background" Value="{ThemeResource EtAccentBrush}" />
                                            <Setter Target="SegmentText.Foreground" Value="{ThemeResource EtTextOnAccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                </VisualStateGroup>
                                <!-- Keyboard focus: 2px double-ring; collapses on PointerOver/Pressed -->
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.15" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="FocusOuter.BorderBrush" Value="{ThemeResource FocusVisualPrimaryBrush}" />
                                            <Setter Target="FocusInner.BorderBrush" Value="{ThemeResource FocusVisualSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="SegmentRoot"
                                CornerRadius="6"
                                Background="Transparent">
                                <ContentPresenter
                                    x:Name="SegmentText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource EtTextSecondaryBrush}" />
                            </Border>
                            <Border x:Name="FocusOuter" BorderThickness="2" BorderBrush="Transparent"
                                    CornerRadius="6" Margin="-3"
                                    IsHitTestVisible="False" />
                            <Border x:Name="FocusInner" BorderThickness="1" BorderBrush="Transparent"
                                    CornerRadius="6" Margin="-1"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.15" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource EtTextPrimary6Brush}" />
                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource EtBorderBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource EtAccent12Brush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
            Single-row routing card. The root is a plain Grid so the control
            stretches to the full ListView row width (Phase 5 wires this into an
            ItemTemplate); the card itself is the inner rounded Border.
        -->
        <Border
            x:Name="CardRoot"
            Height="56"
            Margin="0,4"
            Padding="12,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="{ThemeResource EtSurface1Brush}"
            BorderBrush="{ThemeResource EtBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource EtRadiusSm}"
            PointerEntered="CardRoot_PointerEntered"
            PointerExited="CardRoot_PointerExited"
            PointerPressed="CardRoot_PointerPressed"
            PointerReleased="CardRoot_PointerReleased"
            PointerCaptureLost="CardRoot_PointerCaptureLost">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App icon (or letter/glyph placeholder when unavailable). -->
                <Grid
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="IconFrame"
                        Width="32"
                        Height="32"
                        CornerRadius="{StaticResource EtRadiusSm}">
                        <Image
                            x:Name="IconImage"
                            Width="32"
                            Height="32"
                            Stretch="UniformToFill"
                            Visibility="Collapsed" />
                    </Border>
                    <Border
                        x:Name="IconFallback"
                        Width="32"
                        Height="32"
                        CornerRadius="{StaticResource EtRadiusSm}"
                        Background="{ThemeResource EtSurface2Brush}">
                        <Grid>
                            <Viewbox
                                MaxWidth="18"
                                MaxHeight="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <FontIcon
                                    x:Name="IconFallbackGlyph"
                                    Glyph="&#xE7B8;"
                                    FontSize="16"
                                    Foreground="{ThemeResource EtAccentSecondaryBrush}" />
                            </Viewbox>
                            <TextBlock
                                x:Name="IconFallbackLetter"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource EtAccentSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Friendly name + process file name. -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="NameText"
                        Text="{x:Bind Item.DisplayName, Mode=OneWay}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource EtTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="DetailText"
                        Text="{x:Bind Item.ProcessName, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource EtTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--
                    Three-state routing toggle: Proxy / Direct / Block, styled as a
                    segmented pill group (SegmentedControl is not available in the
                    referenced Windows App SDK, so radio buttons stand in).
                -->
                <Border
                    Grid.Column="2"
                    Width="200"
                    Height="30"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Background="{ThemeResource EtSurface2Brush}"
                    BorderBrush="{ThemeResource EtBorderBrush}"
                    BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="ProxySegment"
                            Grid.Column="0"
                            x:Uid="ProcSegmentProxy"
                            Tag="Proxy"
                            Style="{StaticResource SegmentRadioButtonStyle}"
                            Checked="Segment_Checked" />
                        <RadioButton
                            x:Name="DirectSegment"
                            Grid.Column="1"
                            x:Uid="ProcSegmentDirect"
                            Tag="Direct"
                            Style="{StaticResource SegmentRadioButtonStyle}"
                            Checked="Segment_Checked" />
                        <RadioButton
                            x:Name="BlockSegment"
                            Grid.Column="2"
                            x:Uid="ProcSegmentBlock"
                            Tag="Block"
                            Style="{StaticResource SegmentRadioButtonStyle}"
                            Checked="Segment_Checked" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
