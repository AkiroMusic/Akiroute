<Window
    x:Class="Akiroute.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Akiroute.Views.Controls"
    xmlns:models="using:Akiroute.Models"
    mc:Ignorable="d">

    <!--
        App shell (plan Task 5.1): Mica comes from ThemeHelper.ApplyThemeSafe in
        App (never set in XAML). Layout is a full-width status header above a
        left sidebar and a content area that swaps among the three panels.
    -->
    <Grid x:Name="Root">
        <Grid.Resources>
            <!--
                Sidebar navigation item. Flat transparent pill; the selected item
                swaps to NavItemSelectedStyle from code-behind (the shell is
                DP/event driven, so selection state is tracked by the view, not
                bound through a view model).
            -->
            <Style x:Key="NavItemStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style
                x:Key="NavItemSelectedStyle"
                TargetType="Button"
                BasedOn="{StaticResource NavItemStyle}">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Rounded card used by the traffic and settings sections. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- Panel section heading. -->
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top status bar, wired to the proxy status view model in code-behind. -->
        <controls:StatusHeaderControl
            x:Name="StatusHeader"
            Grid.Row="0"
            Title="Akiroute"
            ToggleRequested="StatusHeader_ToggleRequested" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left sidebar navigation. -->
            <Border
                Grid.Column="0"
                Padding="12,20,12,16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Brand mark. -->
                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="4,0,0,20">
                        <Grid
                            Width="30"
                            Height="30">
                            <Rectangle
                                x:Name="BrandLogo"
                                RadiusX="7"
                                RadiusY="7">
                                <Rectangle.Fill>
                                    <ImageBrush
                                        x:Name="BrandLogoBrush"
                                        Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="Akiroute"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                Text="本地代理路由"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation items. -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <Button
                            x:Name="NavNodesButton"
                            Tag="nodes"
                            Click="NavItem_Click"
                            Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                                <TextBlock Text="节点" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="NavProcessesButton"
                            Tag="processes"
                            Click="NavItem_Click"
                            Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE756;" FontSize="16" />
                                <TextBlock Text="进程" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="NavSettingsButton"
                            Tag="settings"
                            Click="NavItem_Click"
                            Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE713;" FontSize="16" />
                                <TextBlock Text="设置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sidebar footer. -->
                    <TextBlock
                        Grid.Row="2"
                        Margin="4,0,0,0"
                        Text="v0.1.0 · © 2026 Akiro"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextTrimming="CharacterEllipsis">
                        <ToolTipService.ToolTip>
                            <TextBlock
                                Text="Akiroute v0.1.0&#x0a;Copyright © 2026 Akiro. 保留所有权利。&#x0a;本软件仅供学习与交流使用，禁止商业用途、复制与再分发。&#x0a;Akiroute v0.1.0 — All rights reserved. For learning and communication only. No commercial use, copying, or redistribution." />
                        </ToolTipService.ToolTip>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Content area hosting the three panels (swapped by nav selection). -->
            <Grid Grid.Column="1" Padding="20,16">

                <!-- ================= Nodes panel ================= -->
                <Grid x:Name="NodesPanel" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Heading + toolbar. -->
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="节点"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitleStyle}" />
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            MaxWidth="260"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            PlaceholderText="搜索节点"
                            Text="{x:Bind Vm.Nodes.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            CornerRadius="6"
                            Click="OnPingAllClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D5;" FontSize="14" />
                                <TextBlock Text="测速" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            CornerRadius="6"
                            Click="OnImportClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                <TextBlock Text="导入" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="4"
                            Margin="8,0,0,0"
                            CornerRadius="6"
                            Click="OnEditClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock Text="编辑" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Node list; the card raises a bubbling Tapped handled at the ListView. -->
                    <ListView
                        x:Name="NodesList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind Vm.Nodes.Nodes}"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        Tapped="NodesList_Tapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProxyNode">
                                <controls:NodeCardControl Node="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Real-time traffic chart, shown while the proxy is running. -->
                    <Border
                        x:Name="TrafficCard"
                        Grid.Row="2"
                        Padding="8"
                        Style="{StaticResource CardStyle}">
                        <controls:TrafficChartControl
                            x:Name="TrafficChart"
                            DataPoints="{x:Bind Vm.Status.TrafficSeries, Mode=OneWay}"
                            Title="实时流量" />
                    </Border>
                </Grid>

                <!-- ================= Processes panel ================= -->
                <Grid x:Name="ProcessesPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="进程路由"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitleStyle}" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="18"
                            Height="18"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind Vm.Processes.IsRefreshing, Mode=OneWay}" />
                        <Button
                            Grid.Column="2"
                            CornerRadius="6"
                            Click="OnRefreshProcessesClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- Empty-state hint. -->
                        <TextBlock
                            Text="未发现可路由的进程"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind Vm.Processes.IsEmpty, Mode=OneWay}" />

                        <!-- Process list; RadioButton.Checked bubbles here from each card. -->
                        <ListView
                            x:Name="ProcessesList"
                            ItemsSource="{x:Bind Vm.Processes.Items}"
                            SelectionMode="None"
                            IsItemClickEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProcessInfoItem">
                                    <controls:ProcessItemControl Item="{x:Bind}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- ================= Settings panel ================= -->
                <Grid x:Name="SettingsPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="设置"
                        Style="{StaticResource SectionTitleStyle}" />

                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            Spacing="12">
                            <Border Padding="16" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock
                                        Text="代理"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock
                                            Width="160"
                                            Text="路由模式"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox
                                            x:Name="ModeCombo"
                                            MinWidth="200"
                                            SelectionChanged="ModeCombo_SelectionChanged">
                                            <ComboBoxItem Content="全局" Tag="Global" />
                                            <ComboBoxItem Content="规则" Tag="Rule" />
                                            <ComboBoxItem Content="仅直连" Tag="DirectOnly" />
                                            <ComboBoxItem Content="仅进程" Tag="ProcessOnly" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock
                                            Width="160"
                                            Text="本地端口"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox
                                            x:Name="PortBox"
                                            Width="120"
                                            TextChanged="PortBox_TextChanged" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="AutoConnectToggle"
                                        Header="启动时自动连接"
                                        OnContent="开"
                                        OffContent="关"
                                        Toggled="AutoConnectToggle_Toggled" />
                                    <ToggleSwitch
                                        x:Name="TunToggle"
                                        Header="启用 TUN 模式"
                                        OnContent="开"
                                        OffContent="关"
                                        Toggled="TunToggle_Toggled" />
                                </StackPanel>
                            </Border>

                            <Border Padding="16" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock
                                        Text="外观与更新"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock
                                            Width="160"
                                            Text="主题"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox
                                            x:Name="ThemeCombo"
                                            MinWidth="200"
                                            SelectionChanged="ThemeCombo_SelectionChanged">
                                            <ComboBoxItem Content="跟随系统" Tag="System" />
                                            <ComboBoxItem Content="深色" Tag="Dark" />
                                            <ComboBoxItem Content="浅色" Tag="Light" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock
                                            Width="160"
                                            Text="订阅自动更新（分钟）"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox
                                            x:Name="MinutesBox"
                                            Width="120"
                                            TextChanged="MinutesBox_TextChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button
                                Content="保存设置"
                                HorizontalAlignment="Right"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnSaveSettingsClick" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
