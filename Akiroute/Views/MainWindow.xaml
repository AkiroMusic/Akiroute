<Window
    x:Class="Akiroute.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Akiroute.Views.Controls"
    xmlns:models="using:Akiroute.Models"
    mc:Ignorable="d">

    <!--
        App shell (plan Task 5.1/5.2). Theme comes from ThemeHelper.ApplyThemeSafe
        in App (never set in XAML). The opaque ambient layer (spec section 7)
        replaces Mica as the visible backdrop — 4-corner radial glows + film
        grain over the theme base color — so the Ethereal token palette follows
        RequestedTheme. Layout: 40px glass status header, 80px Material-3 style
        nav rail, a max-1180px centered content column (section 9), and a 28px
        glass footer (section 10).

        Selection state is tracked by the view (DP/event driven), so the nav
        buttons swap NavItemStyle / NavItemSelectedStyle from code-behind.
    -->
    <Grid x:Name="Root">
        <Grid.Resources>
            <!--
                Material-3 style rail item (spec section 8): 52px pill, radius 14,
                icon 21px over label 10px. Transparent by default; hover lifts to
                text-primary 6% + secondary text; the selected item swaps to
                NavItemSelectedStyle (accent 13% pill + accent text).
            -->
            <Style x:Key="NavItemStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource EtFontSans}" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Margin" Value="6,2" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource EtTextTertiaryBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.15" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource EtTextPrimary6Brush}" />
                                                <Setter Target="ContentHost.Foreground" Value="{ThemeResource EtTextSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource EtTextPrimary6Brush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter
                                        x:Name="ContentHost"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="NavItemSelectedStyle"
                TargetType="Button"
                BasedOn="{StaticResource NavItemStyle}">
                <Setter Property="Background" Value="{ThemeResource EtAccent13Brush}" />
                <Setter Property="Foreground" Value="{ThemeResource EtAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ambient background: base color + 4 corner glows + film grain (7.1/7.2). -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource EtBgBaseColor}" />
            </Grid.Background>
            <Rectangle Fill="{StaticResource EtGlow1Brush}" />
            <Rectangle Fill="{StaticResource EtGlow2Brush}" />
            <Rectangle Fill="{StaticResource EtGlow3Brush}" />
            <Rectangle Fill="{StaticResource EtGlow4Brush}" />
            <Image
                Source="/Assets/noise.png"
                Opacity="0.035"
                Stretch="UniformToFill" />
        </Grid>

        <!-- Glass status header (40px; template lives in StatusHeaderControl). -->
        <controls:StatusHeaderControl
            x:Name="StatusHeader"
            Grid.Row="0"
            Title="Akiroute"
            ToggleRequested="StatusHeader_ToggleRequested" />

        <!-- Body: nav rail + centered content column. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                80px navigation rail (section 8): brand mark on top, primary
                items below, divider + settings pinned to the bottom.
            -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource EtSurface1Brush}"
                BorderBrush="{ThemeResource EtBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Padding="0,16,0,12">
                    <!-- Brand mark (logo painted from code-behind). -->
                    <Grid
                        Grid.Row="0"
                        Width="36"
                        Height="36"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center">
                        <Rectangle
                            x:Name="BrandLogo"
                            RadiusX="9"
                            RadiusY="9">
                            <Rectangle.Fill>
                                <ImageBrush
                                    x:Name="BrandLogoBrush"
                                    Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <!-- Primary navigation. -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <Button
                            x:Name="NavNodesButton"
                            Tag="nodes"
                            Click="NavItem_Click"
                            Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <FontIcon Glyph="&#xE8F4;" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock Text="节点" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="NavProcessesButton"
                            Tag="processes"
                            Click="NavItem_Click"
                            Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <FontIcon Glyph="&#xE756;" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock Text="进程" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Settings pinned to the bottom of the rail. -->
                    <StackPanel Grid.Row="2" Spacing="4">
                        <Border
                            Height="1"
                            Margin="16,8,16,8"
                            Background="{ThemeResource EtBorderBrush}"
                            Opacity="0.6" />
                        <Button
                            x:Name="NavSettingsButton"
                            Tag="settings"
                            Click="NavItem_Click"
                            Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <FontIcon Glyph="&#xE713;" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock Text="设置" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content column: capped at 1180px, centered with 24/32 padding. -->
            <Grid Grid.Column="1" Margin="24,32,24,24">
                <Grid MaxWidth="1180" HorizontalAlignment="Center">

                    <!-- ================= Nodes panel ================= -->
                    <Grid x:Name="NodesPanel" RowSpacing="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nodes card: card header + toolbar + list. -->
                        <ContentControl
                            Grid.Row="0"
                            Style="{StaticResource BezelCardStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="16">
                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="节点" Style="{StaticResource EtCardTitleStyle}" />
                                        <TextBlock Text="节点管理" Style="{StaticResource EtCardSubtitleStyle}" />
                                    </StackPanel>
                                    <TextBox
                                        x:Name="SearchBox"
                                        Grid.Column="1"
                                        MaxWidth="260"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        PlaceholderText="搜索节点"
                                        Style="{StaticResource EtTextBoxStyle}"
                                        Text="{x:Bind Vm.Nodes.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Style="{StaticResource EtGhostButtonStyle}"
                                            Click="OnPingAllClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE9D5;" FontSize="13" />
                                                <TextBlock Text="测速" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource EtGhostButtonStyle}"
                                            Click="OnImportClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B5;" FontSize="13" />
                                                <TextBlock Text="导入" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource EtGhostButtonStyle}"
                                            Click="OnEditClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                                <TextBlock Text="编辑" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Node list; the card raises a bubbling Tapped handled at the ListView. -->
                                <ListView
                                    x:Name="NodesList"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind Vm.Nodes.Nodes}"
                                    SelectionMode="None"
                                    IsItemClickEnabled="False"
                                    Tapped="NodesList_Tapped">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProxyNode">
                                            <controls:NodeCardControl Node="{x:Bind}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </ContentControl>

                        <!-- Real-time traffic chart, shown while the proxy is running
                             (Visibility is driven from code-behind). -->
                        <ContentControl
                            x:Name="TrafficCard"
                            Grid.Row="1"
                            Style="{StaticResource BezelCardStyle}">
                            <controls:TrafficChartControl
                                x:Name="TrafficChart"
                                DataPoints="{x:Bind Vm.Status.TrafficSeries, Mode=OneWay}"
                                Title="实时流量" />
                        </ContentControl>
                    </Grid>

                    <!-- ================= Processes panel ================= -->
                    <Grid x:Name="ProcessesPanel" Visibility="Collapsed">
                        <ContentControl Style="{StaticResource BezelCardStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="16">
                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="进程路由" Style="{StaticResource EtCardTitleStyle}" />
                                        <TextBlock Text="按进程选择代理路径" Style="{StaticResource EtCardSubtitleStyle}" />
                                    </StackPanel>
                                    <ProgressRing
                                        Grid.Column="1"
                                        Width="18"
                                        Height="18"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind Vm.Processes.IsRefreshing, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource EtGhostButtonStyle}"
                                        Click="OnRefreshProcessesClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock Text="刷新" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <!-- Empty-state hint. -->
                                    <TextBlock
                                        Text="未发现可路由的进程"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource EtCardSubtitleStyle}"
                                        Visibility="{x:Bind Vm.Processes.IsEmpty, Mode=OneWay}" />

                                    <!-- Process list; RadioButton.Checked bubbles here from each card. -->
                                    <ListView
                                        x:Name="ProcessesList"
                                        ItemsSource="{x:Bind Vm.Processes.Items}"
                                        SelectionMode="None"
                                        IsItemClickEnabled="False">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:ProcessInfoItem">
                                                <controls:ProcessItemControl Item="{x:Bind}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </ContentControl>
                    </Grid>

                    <!-- ================= Settings panel ================= -->
                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="24">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="设置" Style="{StaticResource EtCardTitleStyle}" />
                                    <TextBlock Text="路由、外观与更新偏好" Style="{StaticResource EtCardSubtitleStyle}" />
                                </StackPanel>

                                <ContentControl Style="{StaticResource BezelCardStyle}">
                                    <StackPanel Spacing="20">
                                        <TextBlock Text="代理" Style="{StaticResource EtSectionLabelStyle}" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="路由模式"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource EtCardSubtitleStyle}" />
                                            <ComboBox
                                                x:Name="ModeCombo"
                                                Grid.Column="1"
                                                MinWidth="200"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource EtComboBoxStyle}"
                                                SelectionChanged="ModeCombo_SelectionChanged">
                                                <ComboBoxItem Content="全局" Tag="Global" />
                                                <ComboBoxItem Content="规则" Tag="Rule" />
                                                <ComboBoxItem Content="仅直连" Tag="DirectOnly" />
                                                <ComboBoxItem Content="仅进程" Tag="ProcessOnly" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="本地端口"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource EtCardSubtitleStyle}" />
                                            <TextBox
                                                x:Name="PortBox"
                                                Grid.Column="1"
                                                Width="120"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource EtTextBoxStyle}"
                                                TextChanged="PortBox_TextChanged" />
                                        </Grid>
                                        <ToggleSwitch
                                            x:Name="AutoConnectToggle"
                                            Header="启动时自动连接"
                                            OnContent="开"
                                            OffContent="关"
                                            Toggled="AutoConnectToggle_Toggled" />
                                        <ToggleSwitch
                                            x:Name="TunToggle"
                                            Header="启用 TUN 模式"
                                            OnContent="开"
                                            OffContent="关"
                                            Toggled="TunToggle_Toggled" />
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource BezelCardStyle}">
                                    <StackPanel Spacing="20">
                                        <TextBlock Text="外观与更新" Style="{StaticResource EtSectionLabelStyle}" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="主题"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource EtCardSubtitleStyle}" />
                                            <ComboBox
                                                x:Name="ThemeCombo"
                                                Grid.Column="1"
                                                MinWidth="200"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource EtComboBoxStyle}"
                                                SelectionChanged="ThemeCombo_SelectionChanged">
                                                <ComboBoxItem Content="跟随系统" Tag="System" />
                                                <ComboBoxItem Content="深色" Tag="Dark" />
                                                <ComboBoxItem Content="浅色" Tag="Light" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="订阅自动更新（分钟）"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource EtCardSubtitleStyle}" />
                                            <TextBox
                                                x:Name="MinutesBox"
                                                Grid.Column="1"
                                                Width="120"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource EtTextBoxStyle}"
                                                TextChanged="MinutesBox_TextChanged" />
                                        </Grid>
                                    </StackPanel>
                                </ContentControl>

                                <Button
                                    Content="保存设置"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource EtAccentButtonStyle}"
                                    Click="OnSaveSettingsClick" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Glass footer (28px, section 10): copyright left, version right. -->
        <Border
            Grid.Row="2"
            Height="28"
            Background="{ThemeResource EtGlassBrush}"
            BorderBrush="{ThemeResource EtGlassBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="© 2026 Akiro · 仅供学习与交流使用"
                    Style="{StaticResource EtFooterStyle}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="v0.1.1"
                    FontFamily="{StaticResource EtFontMono}"
                    Style="{StaticResource EtFooterStyle}">
                    <ToolTipService.ToolTip>
                        <TextBlock Text="Akiroute v0.1.1&#x0a;Copyright © 2026 Akiro. 保留所有权利。&#x0a;本软件仅供学习与交流使用，禁止商业用途、复制与再分发。&#x0a;Akiroute v0.1.1 — All rights reserved. For learning and communication only. No commercial use, copying, or redistribution." />
                    </ToolTipService.ToolTip>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
