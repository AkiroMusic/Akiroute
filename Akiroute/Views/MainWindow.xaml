<Window
    x:Class="Akiroute.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Akiroute.Views.Controls"
    xmlns:models="using:Akiroute.Models"
    mc:Ignorable="d">

    <!--
        App shell (plan Task 5.1/5.2). Theme comes from ThemeHelper.ApplyThemeSafe
        in App (never set in XAML). The opaque ambient layer (spec section 7)
        replaces Mica as the visible backdrop — 4-corner radial glows + film
        grain over the theme base color — so the Ethereal token palette follows
        RequestedTheme. Layout: 40px glass status header, 80px Material-3 style
        nav rail, a max-1180px centered content column (section 9), and a 28px
        glass footer (section 10).

        Selection state is tracked by the view (DP/event driven), so the nav
        buttons swap NavItemStyle / NavItemSelectedStyle from code-behind.
    -->
    <Grid x:Name="Root">
        <Grid.Resources>
            <!--
                Material-3 style rail item (spec section 8): 52px pill, radius 14,
                icon 21px over label 10px. Transparent by default; hover lifts to
                text-primary 6% + secondary text; the selected item swaps to
                NavItemSelectedStyle (accent 13% pill + accent text).
            -->
            <Style x:Key="NavItemStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource EtFontSans}" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Margin" Value="6,2" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource EtTextTertiaryBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.15" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource EtTextPrimary6Brush}" />
                                                <Setter Target="ContentHost.Foreground" Value="{ThemeResource EtTextSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource EtTextPrimary6Brush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Unfocused" />
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="FocusRect.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <Grid>
                                        <ContentPresenter
                                            x:Name="ContentHost"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Foreground="{TemplateBinding Foreground}" />
                                        <Border
                                            x:Name="FocusRect"
                                            Visibility="Collapsed"
                                            BorderBrush="{ThemeResource FocusVisualPrimaryBrush}"
                                            BorderThickness="2"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="NavItemSelectedStyle"
                TargetType="Button"
                BasedOn="{StaticResource NavItemStyle}">
                <Setter Property="Background" Value="{ThemeResource EtAccent13Brush}" />
                <Setter Property="Foreground" Value="{ThemeResource EtAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ambient background: base color + 4 corner glows + film grain (7.1/7.2). -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource EtBgBaseColor}" />
            </Grid.Background>
            <Rectangle Fill="{StaticResource EtGlow1Brush}" />
            <Rectangle Fill="{StaticResource EtGlow2Brush}" />
            <Rectangle Fill="{StaticResource EtGlow3Brush}" />
            <Rectangle Fill="{StaticResource EtGlow4Brush}" />
            <Image
                Source="/Assets/noise.png"
                Opacity="0.035"
                Stretch="UniformToFill" />
        </Grid>

        <!-- Glass status header (40px; template lives in StatusHeaderControl). -->
        <controls:StatusHeaderControl
            x:Name="StatusHeader"
            Grid.Row="0"
            Title="Akiroute"
            ToggleRequested="StatusHeader_ToggleRequested" />

        <!-- Body: nav rail + centered content column. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                80px navigation rail (section 8): brand mark on top, primary
                items below, divider + settings pinned to the bottom.
            -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource EtSurface1Brush}"
                BorderBrush="{ThemeResource EtBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Padding="0,16,0,12">
                    <!-- Brand mark (logo painted from code-behind). -->
                    <Grid
                        Grid.Row="0"
                        Width="36"
                        Height="36"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center">
                        <Rectangle
                            x:Name="BrandLogo"
                            RadiusX="9"
                            RadiusY="9">
                            <Rectangle.Fill>
                                <ImageBrush
                                    x:Name="BrandLogoBrush"
                                    Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <!-- Primary navigation. -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <Button
                            x:Name="NavNodesButton"
                            Tag="nodes"
                            Click="NavItem_Click"
                            Style="{StaticResource NavItemSelectedStyle}">
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <FontIcon Glyph="&#xE8F4;" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock x:Uid="NavNodesLabel" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="NavProcessesButton"
                            Tag="processes"
                            Click="NavItem_Click"
                            Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <FontIcon Glyph="&#xE756;" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock x:Uid="NavProcessesLabel" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="NavLogsButton"
                            Tag="logs"
                            Click="NavItem_Click"
                            Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <FontIcon Glyph="&#xE9D9;" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock x:Uid="NavLogsLabel" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Settings pinned to the bottom of the rail. -->
                    <StackPanel Grid.Row="2" Spacing="4">
                        <Border
                            Height="1"
                            Margin="16,8,16,8"
                            Background="{ThemeResource EtBorderBrush}"
                            Opacity="0.6" />
                        <Button
                            x:Name="NavSettingsButton"
                            Tag="settings"
                            Click="NavItem_Click"
                            Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <FontIcon Glyph="&#xE713;" FontSize="21" HorizontalAlignment="Center" />
                                <TextBlock x:Uid="NavSettingsLabel" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content column: capped at 1180px, centered with 24/32 padding. -->
            <Grid Grid.Column="1" Margin="24,32,24,24">
                <Grid MaxWidth="1180" HorizontalAlignment="Center">

                    <!-- ================= Nodes panel ================= -->
                    <Grid x:Name="NodesPanel" RowSpacing="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nodes card: card header + toolbar + list. -->
                        <ContentControl
                            Grid.Row="0"
                            Style="{StaticResource BezelCardStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="16">
                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock x:Uid="NodesPageTitle" Style="{StaticResource EtCardTitleStyle}" />
                                        <TextBlock x:Uid="NodesPageSubtitle" Style="{StaticResource EtCardSubtitleStyle}" />
                                    </StackPanel>
                                    <TextBox
                                        x:Name="SearchBox"
                                        Grid.Column="1"
                                        MaxWidth="260"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        x:Uid="NodesSearchBox"
                                        Style="{StaticResource EtTextBoxStyle}"
                                        Text="{x:Bind Vm.Nodes.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <ProgressRing
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            IsActive="{x:Bind Vm.Nodes.IsPinging, Mode=OneWay}"
                                            Visibility="{x:Bind Vm.Nodes.IsPinging, Mode=OneWay}" />
                                        <Button
                                            Style="{StaticResource EtGhostButtonStyle}"
                                            Click="OnPingAllClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE9D5;" FontSize="13" />
                                                <TextBlock x:Uid="NodesPingBtn" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource EtGhostButtonStyle}"
                                            Click="OnImportClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B5;" FontSize="13" />
                                                <TextBlock x:Uid="NodesImportBtn" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource EtGhostButtonStyle}"
                                            Click="OnEditClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                                <TextBlock x:Uid="NodesEditBtn" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <!-- Empty-state hint (visibility driven live from
                                         code-behind via Nodes.CollectionChanged). -->
                                    <TextBlock
                                        x:Name="NodesEmptyHint"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource EtCardSubtitleStyle}"
                                        Visibility="Collapsed">
                                        <Run x:Uid="NodesEmptyLine1" />
                                        <LineBreak />
                                        <Run x:Uid="NodesEmptyLine2" Foreground="{ThemeResource EtTextTertiaryBrush}" FontSize="11" />
                                    </TextBlock>

                                    <!-- Node list; the card raises a bubbling Tapped handled at the ListView. -->
                                    <ListView
                                        x:Name="NodesList"
                                        Grid.Row="1"
                                        ItemsSource="{x:Bind Vm.Nodes.Nodes}"
                                        SelectionMode="None"
                                        IsItemClickEnabled="False"
                                        Tapped="NodesList_Tapped">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProxyNode">
                                            <controls:NodeCardControl Node="{x:Bind}">
                                                <controls:NodeCardControl.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem x:Uid="NodeCtxEdit" Click="OnNodeEditContextClick">
                                                             <MenuFlyoutItem.Icon>
                                                                 <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                                             </MenuFlyoutItem.Icon>
                                                         </MenuFlyoutItem>
                                                         <MenuFlyoutItem x:Uid="NodeCtxDelete" Click="OnNodeDeleteContextClick">
                                                             <MenuFlyoutItem.Icon>
                                                                 <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                             </MenuFlyoutItem.Icon>
                                                         </MenuFlyoutItem>
                                                         <MenuFlyoutSeparator />
                                                         <MenuFlyoutItem x:Uid="NodeCtxCopyAddr" Click="OnNodeCopyAddressClick">
                                                             <MenuFlyoutItem.Icon>
                                                                 <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                             </MenuFlyoutItem.Icon>
                                                         </MenuFlyoutItem>
                                                         <MenuFlyoutItem x:Uid="NodeCtxCopyLink" Click="OnNodeCopyLinkClick">
                                                             <MenuFlyoutItem.Icon>
                                                                 <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                                             </MenuFlyoutItem.Icon>
                                                         </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </controls:NodeCardControl.ContextFlyout>
                                            </controls:NodeCardControl>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </ContentControl>

                        <!-- Real-time traffic chart, shown while the proxy is running
                             (Visibility is driven from code-behind). -->
                        <ContentControl
                            x:Name="TrafficCard"
                            Grid.Row="1"
                            Style="{StaticResource BezelCardStyle}">
                            <controls:TrafficChartControl
                                x:Name="TrafficChart"
                                DataPoints="{x:Bind Vm.Status.TrafficSeries, Mode=OneWay}" />
                        </ContentControl>
                    </Grid>

                    <!-- ================= Processes panel ================= -->
                    <Grid x:Name="ProcessesPanel" Visibility="Collapsed">
                        <ContentControl Style="{StaticResource BezelCardStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="16">
                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock x:Uid="ProcessesTitle" Style="{StaticResource EtCardTitleStyle}" />
                                        <TextBlock x:Uid="ProcessesSubtitle" Style="{StaticResource EtCardSubtitleStyle}" />
                                    </StackPanel>
                                    <ProgressRing
                                        Grid.Column="1"
                                        Width="18"
                                        Height="18"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind Vm.Processes.IsRefreshing, Mode=OneWay}"
                                        Visibility="{x:Bind Vm.Processes.IsRefreshing, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource EtGhostButtonStyle}"
                                        Click="OnRefreshProcessesClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock x:Uid="ProcessesRefreshBtn" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <!-- Empty-state hint. -->
                                    <TextBlock
                                        x:Uid="ProcessesEmptyHint"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource EtCardSubtitleStyle}"
                                        Visibility="{x:Bind Vm.Processes.IsEmpty, Mode=OneWay}" />

                                    <!-- Process list; RadioButton.Checked bubbles here from each card. -->
                                    <ListView
                                        x:Name="ProcessesList"
                                        ItemsSource="{x:Bind Vm.Processes.Items}"
                                        SelectionMode="None"
                                        IsItemClickEnabled="False">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:ProcessInfoItem">
                                                <controls:ProcessItemControl Item="{x:Bind}">
                                                    <controls:ProcessItemControl.ContextFlyout>
                                                        <MenuFlyout>
                                                             <MenuFlyoutItem x:Uid="ProcessCtxProxy" Click="OnProcessActionContextClick" Tag="Proxy">
                                                                 <MenuFlyoutItem.Icon>
                                                                     <FontIcon Glyph="&#xE9D5;" FontSize="14" />
                                                                 </MenuFlyoutItem.Icon>
                                                             </MenuFlyoutItem>
                                                             <MenuFlyoutItem x:Uid="ProcessCtxDirect" Click="OnProcessActionContextClick" Tag="Direct">
                                                                 <MenuFlyoutItem.Icon>
                                                                     <FontIcon Glyph="&#xE774;" FontSize="14" />
                                                                 </MenuFlyoutItem.Icon>
                                                             </MenuFlyoutItem>
                                                             <MenuFlyoutItem x:Uid="ProcessCtxBlock" Click="OnProcessActionContextClick" Tag="Block">
                                                                 <MenuFlyoutItem.Icon>
                                                                     <FontIcon Glyph="&#xE711;" FontSize="14" />
                                                                 </MenuFlyoutItem.Icon>
                                                             </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </controls:ProcessItemControl.ContextFlyout>
                                                </controls:ProcessItemControl>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </ContentControl>
                    </Grid>

                    <!-- ================= Logs panel ================= -->
                    <Grid x:Name="LogsPanel" Visibility="Collapsed" RowSpacing="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 应用日志 card -->
                        <ContentControl Grid.Row="0" Style="{StaticResource BezelCardStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="16">
                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock x:Uid="AppLogTitle" Style="{StaticResource EtCardTitleStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Style="{StaticResource EtGhostButtonStyle}"
                                             Click="OnCopyAppLogClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                                <TextBlock x:Uid="AppLogCopyBtn" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource EtGhostButtonStyle}"
                                            Click="OnRefreshLogsClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock x:Uid="AppLogRefreshBtn" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBox
                                    Grid.Row="1"
                                    Height="230"
                                    FontFamily="{StaticResource EtFontMono}"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Style="{StaticResource EtTextBoxStyle}"
                                    Text="{x:Bind Vm.Logs.AppLogText, Mode=OneWay}" />
                            </Grid>
                        </ContentControl>

                        <!-- 引擎日志 card -->
                        <ContentControl Grid.Row="1" Style="{StaticResource BezelCardStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="16">
                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock x:Uid="EngineLogTitle" Style="{StaticResource EtCardTitleStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Style="{StaticResource EtGhostButtonStyle}"
                                             Click="OnCopyEngineLogClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                                <TextBlock x:Uid="EngineLogCopyBtn" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource EtGhostButtonStyle}"
                                            Click="OnRefreshLogsClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock x:Uid="EngineLogRefreshBtn" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBox
                                    Grid.Row="1"
                                    Height="300"
                                    FontFamily="{StaticResource EtFontMono}"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Style="{StaticResource EtTextBoxStyle}"
                                    Text="{x:Bind Vm.Logs.EngineLogText, Mode=OneWay}" />
                            </Grid>
                        </ContentControl>
                    </Grid>

                    <!-- ================= Settings panel ================= -->
                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="24">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="SettingsTitle" Style="{StaticResource EtCardTitleStyle}" />
                                    <TextBlock x:Uid="SettingsSubtitle" Style="{StaticResource EtCardSubtitleStyle}" />
                                </StackPanel>

                                <ContentControl Style="{StaticResource BezelCardStyle}">
                                    <StackPanel Spacing="20">
                                        <TextBlock x:Uid="SettingsProxyLabel" Style="{StaticResource EtSectionLabelStyle}" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                x:Uid="SettingsRoutingMode"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource EtCardSubtitleStyle}" />
                                            <ComboBox
                                                x:Name="ModeCombo"
                                                Grid.Column="1"
                                                MinWidth="200"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource EtComboBoxStyle}"
                                                SelectionChanged="ModeCombo_SelectionChanged">
                                                <ComboBoxItem x:Uid="SettingsModeGlobal" Tag="Global" />
                                                <ComboBoxItem x:Uid="SettingsModeRule" Tag="Rule" />
                                                <ComboBoxItem x:Uid="SettingsModeDirectOnly" Tag="DirectOnly" />
                                                <ComboBoxItem x:Uid="SettingsModeProcessOnly" Tag="ProcessOnly" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                x:Uid="SettingsLocalPort"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource EtCardSubtitleStyle}" />
                                            <TextBox
                                                x:Name="PortBox"
                                                Grid.Column="1"
                                                Width="120"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource EtTextBoxStyle}"
                                                TextChanged="PortBox_TextChanged" />
                                        </Grid>
                                        <ToggleSwitch
                                            x:Name="AutoConnectToggle"
                                            x:Uid="SettingsAutoConnect"
                                            Toggled="AutoConnectToggle_Toggled" />
                                        <ToggleSwitch
                                            x:Name="TunToggle"
                                            x:Uid="SettingsTun"
                                            Toggled="TunToggle_Toggled" />
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource BezelCardStyle}">
                                    <StackPanel Spacing="20">
                                        <TextBlock x:Uid="SettingsAppearanceLabel" Style="{StaticResource EtSectionLabelStyle}" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                x:Uid="SettingsTheme"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource EtCardSubtitleStyle}" />
                                            <ComboBox
                                                x:Name="ThemeCombo"
                                                Grid.Column="1"
                                                MinWidth="200"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource EtComboBoxStyle}"
                                                SelectionChanged="ThemeCombo_SelectionChanged">
                                                <ComboBoxItem x:Uid="SettingsThemeSystem" Tag="System" />
                                                <ComboBoxItem x:Uid="SettingsThemeDark" Tag="Dark" />
                                                <ComboBoxItem x:Uid="SettingsThemeLight" Tag="Light" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                x:Uid="SettingsSubAutoUpdate"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource EtCardSubtitleStyle}" />
                                            <TextBox
                                                x:Name="MinutesBox"
                                                Grid.Column="1"
                                                Width="120"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource EtTextBoxStyle}"
                                                TextChanged="MinutesBox_TextChanged" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                x:Uid="SettingsAutoPing"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource EtCardSubtitleStyle}" />
                                            <TextBox
                                                x:Name="PingMinutesBox"
                                                Grid.Column="1"
                                                Width="120"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource EtTextBoxStyle}"
                                                TextChanged="PingMinutesBox_TextChanged" />
                                        </Grid>
                                    </StackPanel>
                                </ContentControl>

                                <!-- 订阅源管理卡片 / Subscription management card -->
                                <ContentControl Style="{StaticResource BezelCardStyle}">
                                    <StackPanel Spacing="16">
                                        <TextBlock x:Uid="SettingsSubscriptionsLabel" Style="{StaticResource EtSectionLabelStyle}" />

                                        <!-- 暂无订阅源提示（类似 NodesEmptyHint 模式） -->
                                        <TextBlock
                                            x:Name="SubscriptionsEmptyHint"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource EtCardSubtitleStyle}"
                                            Visibility="Collapsed">
                                            <Run x:Uid="SubsEmptyLine1" />
                                            <LineBreak />
                                            <Run x:Uid="SubsEmptyLine2" Foreground="{ThemeResource EtTextTertiaryBrush}" FontSize="11" />
                                        </TextBlock>

                                        <!-- 订阅源列表 -->
                                        <ListView
                                            x:Name="SubscriptionsList"
                                            ItemsSource="{x:Bind Vm.Settings.SubscriptionEntries, Mode=OneWay}"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:SubscriptionEntry">
                                                    <Grid
                                                        Margin="0,0,0,8"
                                                        ColumnSpacing="8"
                                                        ColumnDefinitions="*,Auto,Auto,Auto">
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis"
                                                                Style="{StaticResource EtCardSubtitleStyle}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource EtTextTertiaryBrush}"
                                                                    Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    x:Name="LastUpdatedText"
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource EtTextTertiaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <!-- 每订阅覆盖自动更新间隔（分钟），0=跟随全局 -->
                                                        <TextBox
                                                            Grid.Column="1"
                                                            Width="60"
                                                            Height="24"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource EtTextBoxStyle}"
                                                            Text="{x:Bind AutoUpdateMinutes, Mode=OneTime}"
                                                            TextChanged="SubAutoUpdateBox_TextChanged"
                                                            ToolTipService.ToolTip="Override global interval (0 = follow global)" />
                                                        <Button
                                                            Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource EtGhostButtonStyle}"
                                                            Click="OnRemoveSubscriptionClick"
                                                            Tag="{Binding}">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </ContentControl>

                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                                    <Button
                                        x:Name="BackupConfigButton"
                                        Style="{StaticResource EtGhostButtonStyle}"
                                        Click="OnBackupConfigClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE792;" FontSize="13" />
                                            <TextBlock x:Uid="SettingsBackupBtn" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="RestoreConfigButton"
                                        Style="{StaticResource EtGhostButtonStyle}"
                                        Click="OnRestoreConfigClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                            <TextBlock x:Uid="SettingsRestoreBtn" />
                                        </StackPanel>
                                    </Button>
                                        <Button
                                            x:Name="SaveSettingsButton"
                                            x:Uid="SettingsSaveBtn"
                                            Style="{StaticResource EtAccentButtonStyle}"
                                            Click="OnSaveSettingsClick" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Glass footer (28px, section 10): copyright left, version right. -->
        <Border
            Grid.Row="2"
            Height="28"
            Background="{ThemeResource EtGlassBrush}"
            BorderBrush="{ThemeResource EtGlassBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                    <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    x:Uid="FooterCopyright"
                    Style="{StaticResource EtFooterStyle}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="v0.1.1"
                    FontFamily="{StaticResource EtFontMono}"
                    Style="{StaticResource EtFooterStyle}">
                    <ToolTipService.ToolTip>
                        <TextBlock x:Uid="FooterVersionTooltip" />
                    </ToolTipService.ToolTip>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
