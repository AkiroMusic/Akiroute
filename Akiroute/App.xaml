<Application
    x:Class="Akiroute.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                    Ethereal Glass design tokens (Aki-Design-System): palette,
                    fonts, radius, spacing, button/card styles. Merged after
                    XamlControlsResources so our resources win on collisions.
                -->
                <ResourceDictionary Source="Themes/Ethereal.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
