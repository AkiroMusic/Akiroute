<?xml version="1.0" encoding="utf-8"?>
<!--
    Ethereal Glass — Aki-Design-System token dictionary for WinUI 3.

    Translation notes (CSS -> WinUI):
    - color-mix() has no WinUI equivalent, so every accent/text alpha variant
      used by the design is precomputed as an explicit Color resource. They are
      grouped per theme (Dark/Light) so they still follow the theme.
    - backdrop-filter blur is provided by the window Mica backdrop; the
      header/footer "glass" is a semi-transparent surface tint + hairline.
    - The 6 web themes collapse to the app's supported Dark/Light pair
      (AppTheme enum: System/Dark/Light); tokens below use the spec's 3.2/3.3.
    - The double-bezel card is a reusable ContentControl style (BezelCardStyle)
      since WinUI has no ::before pseudo-element.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================== -->
    <!-- Theme dictionaries (Dark default / Light)                          -->
    <!-- ================================================================== -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- 3.2 Dark palette -->
            <Color x:Key="EtBgBaseColor">#0E1016</Color>
            <Color x:Key="EtSurface1Color">#171A23</Color>
            <Color x:Key="EtSurface2Color">#212531</Color>
            <Color x:Key="EtBorderColor">#2E3342</Color>
            <Color x:Key="EtTextPrimaryColor">#F0EEE7</Color>
            <Color x:Key="EtTextSecondaryColor">#8D93A3</Color>
            <Color x:Key="EtTextTertiaryColor">#5B606E</Color>
            <Color x:Key="EtAccentColor">#6C8CFF</Color>
            <Color x:Key="EtAccentHoverColor">#86A3FF</Color>
            <Color x:Key="EtAccentSecondaryColor">#A78BFA</Color>
            <Color x:Key="EtAccentTertiaryColor">#F0A0D8</Color>
            <Color x:Key="EtSuccessColor">#4FAE8A</Color>
            <Color x:Key="EtErrorColor">#D9695F</Color>
            <Color x:Key="EtWarningColor">#E8A33D</Color>

            <!-- Ambient glow colors (spec .ambient-bg Dark values, alpha only) -->
            <Color x:Key="EtGlow1Color">#246C8CFF</Color>
            <Color x:Key="EtGlow2Color">#1CA78BFA</Color>
            <Color x:Key="EtGlow3Color">#146C8CFF</Color>
            <Color x:Key="EtGlow4Color">#12F0A0D8</Color>

            <!-- Glass (spec section 5) -->
            <Color x:Key="EtGlassColor">#9E171A23</Color>
            <Color x:Key="EtGlassBorderColor">#14FFFFFF</Color>

            <!-- Solid brushes -->
            <SolidColorBrush x:Key="EtBgBaseBrush" Color="{StaticResource EtBgBaseColor}" />
            <SolidColorBrush x:Key="EtSurface1Brush" Color="{StaticResource EtSurface1Color}" />
            <SolidColorBrush x:Key="EtSurface2Brush" Color="{StaticResource EtSurface2Color}" />
            <SolidColorBrush x:Key="EtBorderBrush" Color="{StaticResource EtBorderColor}" />
            <SolidColorBrush x:Key="EtTextPrimaryBrush" Color="{StaticResource EtTextPrimaryColor}" />
            <SolidColorBrush x:Key="EtTextSecondaryBrush" Color="{StaticResource EtTextSecondaryColor}" />
            <SolidColorBrush x:Key="EtTextTertiaryBrush" Color="{StaticResource EtTextTertiaryColor}" />
            <SolidColorBrush x:Key="EtAccentBrush" Color="{StaticResource EtAccentColor}" />
            <SolidColorBrush x:Key="EtAccentHoverBrush" Color="{StaticResource EtAccentHoverColor}" />
            <SolidColorBrush x:Key="EtAccentSecondaryBrush" Color="{StaticResource EtAccentSecondaryColor}" />
            <SolidColorBrush x:Key="EtAccentTertiaryBrush" Color="{StaticResource EtAccentTertiaryColor}" />
            <SolidColorBrush x:Key="EtSuccessBrush" Color="{StaticResource EtSuccessColor}" />
            <SolidColorBrush x:Key="EtErrorBrush" Color="{StaticResource EtErrorColor}" />
            <SolidColorBrush x:Key="EtWarningBrush" Color="{StaticResource EtWarningColor}" />

            <!-- Precomputed alpha variants (replaces color-mix) -->
            <!-- accent 4% / 8% / 10% / 12% / 13% / 15% / 20% -->
            <SolidColorBrush x:Key="EtAccent4Brush" Color="#0A6C8CFF" />
            <SolidColorBrush x:Key="EtAccent8Brush" Color="#146C8CFF" />
            <SolidColorBrush x:Key="EtAccent10Brush" Color="#1A6C8CFF" />
            <SolidColorBrush x:Key="EtAccent12Brush" Color="#1F6C8CFF" />
            <SolidColorBrush x:Key="EtAccent13Brush" Color="#216C8CFF" />
            <SolidColorBrush x:Key="EtAccent15Brush" Color="#266C8CFF" />
            <SolidColorBrush x:Key="EtAccent20Brush" Color="#336C8CFF" />
            <!-- text-primary 4% / 6% -->
            <SolidColorBrush x:Key="EtTextPrimary4Brush" Color="#0AF0EEE7" />
            <SolidColorBrush x:Key="EtTextPrimary6Brush" Color="#0FF0EEE7" />
            <!-- status 8% / 20% for badges -->
            <SolidColorBrush x:Key="EtSuccess8Brush" Color="#144FAE8A" />
            <SolidColorBrush x:Key="EtSuccess20Brush" Color="#334FAE8A" />
            <SolidColorBrush x:Key="EtError8Brush" Color="#14D9695F" />
            <SolidColorBrush x:Key="EtError20Brush" Color="#33D9695F" />
            <SolidColorBrush x:Key="EtWarning8Brush" Color="#14E8A33D" />
            <SolidColorBrush x:Key="EtWarning20Brush" Color="#33E8A33D" />
            <!-- glass surface (header/footer) -->
            <SolidColorBrush x:Key="EtGlassBrush" Color="{StaticResource EtGlassColor}" />
            <SolidColorBrush x:Key="EtGlassBorderBrush" Color="{StaticResource EtGlassBorderColor}" />
            <!-- inner bezel line: rgba(255,255,255,0.045) -->
            <SolidColorBrush x:Key="EtInnerLineBrush" Color="#0BFFFFFF" />
            <!-- Text on accent backgrounds: white provides ~3.1:1 contrast against Dark
                 accent #6C8CFF — passes WCAG AA for large/bold text (≥14px bold);
                 standard convention for accent-filled buttons across Fluent/Apple/Google -->
            <SolidColorBrush x:Key="EtTextOnAccentBrush" Color="#FFFFFF" />
            <!-- Keyboard focus rings (used by all custom ControlTemplates). Defined here
                 so template parsing never depends on uncertain system resource keys. -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#66FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- 3.3 Light palette -->
            <Color x:Key="EtBgBaseColor">#F5F5F7</Color>
            <Color x:Key="EtSurface1Color">#FFFFFF</Color>
            <Color x:Key="EtSurface2Color">#EBEBED</Color>
            <Color x:Key="EtBorderColor">#D1D1D6</Color>
            <Color x:Key="EtTextPrimaryColor">#1C1C1E</Color>
            <Color x:Key="EtTextSecondaryColor">#6C6C70</Color>
            <Color x:Key="EtTextTertiaryColor">#AEAEB2</Color>
            <Color x:Key="EtAccentColor">#5B7FFF</Color>
            <Color x:Key="EtAccentHoverColor">#4A6FE8</Color>
            <Color x:Key="EtAccentSecondaryColor">#8B6FE8</Color>
            <Color x:Key="EtAccentTertiaryColor">#D4893B</Color>
            <Color x:Key="EtSuccessColor">#34C759</Color>
            <Color x:Key="EtErrorColor">#FF3B30</Color>
            <Color x:Key="EtWarningColor">#E8A33D</Color>

            <!-- Ambient glow colors (spec Light .ambient-bg values) -->
            <Color x:Key="EtGlow1Color">#175B7FFF</Color>
            <Color x:Key="EtGlow2Color">#128B6FE8</Color>
            <Color x:Key="EtGlow3Color">#0D5B7FFF</Color>
            <Color x:Key="EtGlow4Color">#0D5B7FFF</Color>

            <!-- Glass (spec 3.3 Light: rgba(255,255,255,0.68)) -->
            <Color x:Key="EtGlassColor">#ADFFFFFF</Color>
            <Color x:Key="EtGlassBorderColor">#141C1C1E</Color>

            <SolidColorBrush x:Key="EtBgBaseBrush" Color="{StaticResource EtBgBaseColor}" />
            <SolidColorBrush x:Key="EtSurface1Brush" Color="{StaticResource EtSurface1Color}" />
            <SolidColorBrush x:Key="EtSurface2Brush" Color="{StaticResource EtSurface2Color}" />
            <SolidColorBrush x:Key="EtBorderBrush" Color="{StaticResource EtBorderColor}" />
            <SolidColorBrush x:Key="EtTextPrimaryBrush" Color="{StaticResource EtTextPrimaryColor}" />
            <SolidColorBrush x:Key="EtTextSecondaryBrush" Color="{StaticResource EtTextSecondaryColor}" />
            <SolidColorBrush x:Key="EtTextTertiaryBrush" Color="{StaticResource EtTextTertiaryColor}" />
            <SolidColorBrush x:Key="EtAccentBrush" Color="{StaticResource EtAccentColor}" />
            <SolidColorBrush x:Key="EtAccentHoverBrush" Color="{StaticResource EtAccentHoverColor}" />
            <SolidColorBrush x:Key="EtAccentSecondaryBrush" Color="{StaticResource EtAccentSecondaryColor}" />
            <SolidColorBrush x:Key="EtAccentTertiaryBrush" Color="{StaticResource EtAccentTertiaryColor}" />
            <SolidColorBrush x:Key="EtSuccessBrush" Color="{StaticResource EtSuccessColor}" />
            <SolidColorBrush x:Key="EtErrorBrush" Color="{StaticResource EtErrorColor}" />
            <SolidColorBrush x:Key="EtWarningBrush" Color="{StaticResource EtWarningColor}" />

            <SolidColorBrush x:Key="EtAccent4Brush" Color="#0A5B7FFF" />
            <SolidColorBrush x:Key="EtAccent8Brush" Color="#145B7FFF" />
            <SolidColorBrush x:Key="EtAccent10Brush" Color="#1A5B7FFF" />
            <SolidColorBrush x:Key="EtAccent12Brush" Color="#1F5B7FFF" />
            <SolidColorBrush x:Key="EtAccent13Brush" Color="#215B7FFF" />
            <SolidColorBrush x:Key="EtAccent15Brush" Color="#265B7FFF" />
            <SolidColorBrush x:Key="EtAccent20Brush" Color="#335B7FFF" />
            <SolidColorBrush x:Key="EtTextPrimary4Brush" Color="#0A1C1C1E" />
            <SolidColorBrush x:Key="EtTextPrimary6Brush" Color="#0F1C1C1E" />
            <SolidColorBrush x:Key="EtSuccess8Brush" Color="#1434C759" />
            <SolidColorBrush x:Key="EtSuccess20Brush" Color="#3334C759" />
            <SolidColorBrush x:Key="EtError8Brush" Color="#14FF3B30" />
            <SolidColorBrush x:Key="EtError20Brush" Color="#33FF3B30" />
            <SolidColorBrush x:Key="EtWarning8Brush" Color="#14E8A33D" />
            <SolidColorBrush x:Key="EtWarning20Brush" Color="#33E8A33D" />
            <SolidColorBrush x:Key="EtGlassBrush" Color="{StaticResource EtGlassColor}" />
            <SolidColorBrush x:Key="EtGlassBorderBrush" Color="{StaticResource EtGlassBorderColor}" />
            <SolidColorBrush x:Key="EtInnerLineBrush" Color="#0B1C1C1E" />
            <!-- Text on accent backgrounds: white on Light accent #5B7FFF ≈ 3.5:1 contrast;
                 passes WCAG AA for large/bold text (≥14px bold); 12px SemiBold pill labels
                 follow standard accent-text conventions for interactive elements -->
            <SolidColorBrush x:Key="EtTextOnAccentBrush" Color="#FFFFFF" />
            <!-- Keyboard focus rings (used by all custom ControlTemplates). Defined here
                 so template parsing never depends on uncertain system resource keys. -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#FF1C1C1E" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#661C1C1E" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ================================================================== -->
    <!-- Typography (theme-independent)                                      -->
    <!-- ================================================================== -->
    <FontFamily x:Key="EtFontSans">ms-appx:///Assets/Fonts/PlusJakartaSans.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="EtFontDisplay">ms-appx:///Assets/Fonts/Fraunces.ttf#Fraunces</FontFamily>
    <FontFamily x:Key="EtFontMono">ms-appx:///Assets/Fonts/IBMPlexMono.ttf#IBM Plex Mono</FontFamily>

    <!-- ================================================================== -->
    <!-- Radius scale (4.2: sm 10 / md 16 / lg 24 / full 999)               -->
    <!-- ================================================================== -->
    <CornerRadius x:Key="EtRadiusSm">10</CornerRadius>
    <CornerRadius x:Key="EtRadiusMd">16</CornerRadius>
    <CornerRadius x:Key="EtRadiusLg">24</CornerRadius>
    <CornerRadius x:Key="EtRadiusFull">999</CornerRadius>

    <!-- ================================================================== -->
    <!-- Spacing scale (4.1)                                                 -->
    <!-- ================================================================== -->
    <x:Double x:Key="EtSpace1">4</x:Double>
    <x:Double x:Key="EtSpace2">8</x:Double>
    <x:Double x:Key="EtSpace3">12</x:Double>
    <x:Double x:Key="EtSpace4">16</x:Double>
    <x:Double x:Key="EtSpace6">24</x:Double>
    <x:Double x:Key="EtSpace8">32</x:Double>
    <x:Double x:Key="EtSpace12">48</x:Double>

    <!-- ================================================================== -->
    <!-- Typography styles                                                   -->
    <!-- ================================================================== -->

    <!-- Card title: Fraunces 20px 600, lh 1.25, tracking -0.01em (0.01em at
         20px = 2/1000 em units; WinUI CharacterSpacing is in 1/1000 em) -->
    <Style x:Key="EtCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EtFontDisplay}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource EtTextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="25" />
    </Style>

    <!-- Card subtitle: 12px tertiary -->
    <Style x:Key="EtCardSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EtFontSans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource EtTextSecondaryBrush}" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <!-- Section label: 13px -->
    <Style x:Key="EtSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EtFontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource EtTextPrimaryBrush}" />
    </Style>

    <!-- Micro label (sidebar / badge): 10px, tracking 0.02em -->
    <Style x:Key="EtMicroLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EtFontSans}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource EtTextSecondaryBrush}" />
    </Style>

    <!-- Footer: 12px tertiary (11px fell below the WCAG-recommended minimum) -->
    <Style x:Key="EtFooterStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EtFontSans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource EtTextTertiaryBrush}" />
    </Style>

    <!-- ================================================================== -->
    <!-- Buttons                                                             -->
    <!-- ================================================================== -->

    <!-- 11.3 Ghost / secondary button -->
    <Style x:Key="EtGhostButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource EtFontSans}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource EtTextTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EtBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="{StaticResource EtRadiusSm}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Foreground" Value="{ThemeResource EtTextSecondaryBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource EtTextTertiaryBrush}" />
                                        <Setter Target="FocusOuter.BorderBrush" Value="Transparent" />
                                        <Setter Target="FocusInner.BorderBrush" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource EtTextPrimary6Brush}" />
                                        <Setter Target="FocusOuter.BorderBrush" Value="Transparent" />
                                        <Setter Target="FocusInner.BorderBrush" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- Keyboard focus: 2px double-ring; collapses on PointerOver/Pressed -->
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusOuter.BorderBrush" Value="{ThemeResource FocusVisualPrimaryBrush}" />
                                        <Setter Target="FocusInner.BorderBrush" Value="{ThemeResource FocusVisualSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <Border x:Name="FocusOuter" BorderThickness="2" BorderBrush="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}" Margin="-3"
                                IsHitTestVisible="False" />
                        <Border x:Name="FocusInner" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}" Margin="-1"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 11.2 Primary / accent button: accent 12% bg + accent text + accent border -->
    <Style x:Key="EtAccentButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource EtFontSans}" />
        <Setter Property="Background" Value="{ThemeResource EtAccent12Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource EtAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EtAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="CornerRadius" Value="{StaticResource EtRadiusSm}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource EtAccent15Brush}" />
                                        <Setter Target="FocusOuter.BorderBrush" Value="Transparent" />
                                        <Setter Target="FocusInner.BorderBrush" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource EtAccent20Brush}" />
                                        <Setter Target="FocusOuter.BorderBrush" Value="Transparent" />
                                        <Setter Target="FocusInner.BorderBrush" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- Keyboard focus: 2px double-ring; collapses on PointerOver/Pressed -->
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusOuter.BorderBrush" Value="{ThemeResource FocusVisualPrimaryBrush}" />
                                        <Setter Target="FocusInner.BorderBrush" Value="{ThemeResource FocusVisualSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <Border x:Name="FocusOuter" BorderThickness="2" BorderBrush="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}" Margin="-3"
                                IsHitTestVisible="False" />
                        <Border x:Name="FocusInner" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}" Margin="-1"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- Inputs (11.1: surface-2 bg, sm radius, accent focus border)         -->
    <!-- ================================================================== -->
    <Style x:Key="EtTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource EtSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EtBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource EtRadiusSm}" />
        <Setter Property="FontFamily" Value="{StaticResource EtFontSans}" />
        <Setter Property="Foreground" Value="{ThemeResource EtTextPrimaryBrush}" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource EtTextTertiaryBrush}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="EtComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource EtSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EtBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource EtRadiusSm}" />
        <Setter Property="FontFamily" Value="{StaticResource EtFontSans}" />
        <Setter Property="Foreground" Value="{ThemeResource EtTextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- ================================================================== -->
    <!-- Double-bezel card (section 10)                                      -->
    <!-- ================================================================== -->
    <Style x:Key="BezelCardStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{ThemeResource EtSurface1Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EtBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource EtRadiusLg}">
                        <Grid>
                            <!-- Inner bezel: 5px inset hairline, radius = lg - 5 -->
                            <Border
                                Margin="5"
                                CornerRadius="19"
                                BorderBrush="{ThemeResource EtInnerLineBrush}"
                                BorderThickness="1"
                                IsHitTestVisible="False" />
                            <!-- Top inner highlight (inset 0 1px 0 white 4%) -->
                            <Border
                                Margin="5,6,5,5"
                                CornerRadius="19"
                                BorderBrush="{ThemeResource EtInnerLineBrush}"
                                BorderThickness="0,1,0,0"
                                Opacity="0.6"
                                IsHitTestVisible="False" />
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ambient radial glow brushes (4-corner composition, section 7) -->
    <RadialGradientBrush x:Key="EtGlow1Brush" Center="0.12,0.08" GradientOrigin="0.12,0.08" RadiusX="0.38" RadiusY="0.44">
        <GradientStop Offset="0" Color="{ThemeResource EtGlow1Color}" />
        <GradientStop Offset="0.62" Color="Transparent" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="EtGlow2Brush" Center="0.92,0.12" GradientOrigin="0.92,0.12" RadiusX="0.42" RadiusY="0.48">
        <GradientStop Offset="0" Color="{ThemeResource EtGlow2Color}" />
